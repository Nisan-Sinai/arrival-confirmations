# ─────────────────────────────────────────────────────────────────────────────
# אישורי הגעה — משתני סביבה
#
# העתיקו לקובץ .env.local ומלאו ערכים אמיתיים. .env.local לעולם לא נכנס ל-git.
# הוראות מלאות: SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── ציבורי (מגיע לדפדפן) ─────────────────────────────────────────────────────
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# כתובת הבסיס של האתר. בפיתוח: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── שרת בלבד (אסור בהחלט עם קידומת NEXT_PUBLIC_) ────────────────────────────
# Supabase → Project Settings → API Keys → service_role (secret)
# עוקף RLS. משמש אך ורק במודולים תחת lib/server/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# פלפל לגיבוב טוקנים. 32 תווים לפחות. ייצור: openssl rand -base64 48
TOKEN_PEPPER=generate-a-long-random-value-at-least-32-chars
# פלפל נפרד לגיבוב כתובות IP (§4.8). חייב להיות שונה מ-TOKEN_PEPPER.
IP_HASH_PEPPER=generate-a-different-long-random-value-32-chars

# ── טסטים בלבד (לא נדרש להרצת האפליקציה) ────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
# משמש ל-reset ו-seed של מסד הטסטים, מקומית וב-CI.
TEST_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# משתמשי בדיקה שנוצרים על ידי סקריפט ה-seed.
TEST_ADMIN_EMAIL=admin@example.test
TEST_ADMIN_PASSWORD=change-me-strong-password
TEST_USER_EMAIL=user@example.test
TEST_USER_PASSWORD=change-me-strong-password
# כתובת הבסיס שמולה ירוצו טסטי Playwright.
TEST_BASE_URL=http://localhost:3000
