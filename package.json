{
  "name": "arrival-confirmations",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:homepage": "prettier --write app/page.tsx",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:rls": "vitest run --project rls",
    "test:security": "vitest run --project security",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "test:mutation": "stryker run --incremental",
    "test:mutation:full": "stryker run",
    "data:retention:cleanup": "tsx scripts/data-retention-cleanup.ts",
    "check:auth-urls": "tsx scripts/check-auth-urls.ts",
    "check:schema-drift": "tsx scripts/check-schema-drift.ts",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "test:dependency-audit": "node --test tests/security/dependency-audit.test.mjs",
    "test:local-fonts": "node --test tests/security/local-fonts.test.mjs",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "deadcode": "knip",
    "supabase:start": "tsx scripts/supabase-local-notice.ts",
    "supabase:stop": "tsx scripts/supabase-local-notice.ts",
    "supabase:types": "tsx scripts/gen-types.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "ci": "pnpm check && pnpm test:dependency-audit && pnpm test:local-fonts && pnpm check:dependency-audit && pnpm test:coverage && pnpm build && pnpm scan:secrets && pnpm test:e2e"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hebcal/core": "6.14.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
